#!/usr/bin/env bash
#
# pre-commit: make "edit stats.json and nothing else" true.
#
# Rewrites every published file from stats.json and stages whatever changed,
# so committing a new number is all you have to do. The proof strips, meta
# descriptions, JSON-LD, prose and llms.txt all move with it.
#
# Installed by:  sh/install-hooks.sh
# To skip once:  git commit --no-verify
#
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

OUT=$(node sh/apply-stats.mjs --porcelain 2>&1) || {
  printf '\n\033[31mapply-stats failed, commit aborted:\033[0m\n%s\n' "$OUT"
  exit 1
}

FILES=$(printf '%s\n' "$OUT" | sed -n '/^---FILES---$/,$p' | tail -n +2)
printf '%s\n' "$OUT" | sed '/^---FILES---$/,$d'

# brand-entity.json is the single source of truth for who this company is, the
# way stats.json is for the numbers. It writes the company block, the founder
# blocks and any data-brand slot. Runs before the dates, so that a page changed
# only by this counts as changed when the dates are worked out.
BRAND=$(node sh/apply-brand.mjs --porcelain 2>&1) || {
  printf '\n\033[31mapply-brand failed, commit aborted:\033[0m\n%s\n' "$BRAND"
  exit 1
}
printf '%s\n' "$BRAND" | sed '/^---FILES---$/,$d'
FILES="$FILES
$(printf '%s\n' "$BRAND" | sed -n '/^---FILES---$/,$p' | tail -n +2)"

# Bumps the last-updated date of any page whose own content changed in this
# commit, and writes every page's dates from sh/page-dates.json. It reads git
# to decide which pages changed, so it has to run after everything that edits
# a page and before llms-full.txt is built from them.
DATES=$(node sh/apply-dates.mjs --porcelain 2>&1) || {
  printf '\n\033[31mapply-dates failed, commit aborted:\033[0m\n%s\n' "$DATES"
  exit 1
}
printf '%s\n' "$DATES" | sed '/^---FILES---$/,$d'
FILES="$FILES
$(printf '%s\n' "$DATES" | sed -n '/^---FILES---$/,$p' | tail -n +2)"

# llms-full.txt is the whole site as plain text for AI crawlers. It is derived
# from the HTML, so it has to run AFTER apply-stats, apply-brand and
# apply-dates, never before: any other order captures the previous values of
# whatever just moved.
LLMS=$(node sh/build-llms-full.mjs --porcelain 2>&1) || {
  printf '\n\033[31mbuild-llms-full failed, commit aborted:\033[0m\n%s\n' "$LLMS"
  exit 1
}
printf '%s\n' "$LLMS" | sed '/^---FILES---$/,$d'
FILES="$FILES
$(printf '%s\n' "$LLMS" | sed -n '/^---FILES---$/,$p' | tail -n +2)"

if [ -n "$FILES" ]; then
  # Only stage files that this commit already touches, or that apply-stats
  # rewrote because a number moved. Staging is what makes it automatic; the
  # alternative is aborting the commit and asking you to add them yourself.
  printf '\033[32m  staged:\033[0m\n'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    git add -- "$f"
    printf '    %s\n' "$f"
  done <<< "$FILES"
fi

exit 0
